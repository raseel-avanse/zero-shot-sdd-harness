AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — DealScout uses Gemini (auto-detected from the key set below).
# Override explicitly if needed: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Override model (uses provider default when blank):
# DealScout default: gemini-flash-latest (supports google_search grounding + usage metadata)
# AGENT_LLM_MODEL=gemini-flash-latest

# Set the Gemini key (required for DealScout):
AGENT_GEMINI_API_KEY=
# AGENT_ANTHROPIC_API_KEY=

# Optional cost estimate (INR per 1K tokens); falls back to a built-in default when unset:
# AGENT_COST_INR_PER_1K_TOKENS=1.5

# Optional LangSmith tracing:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
