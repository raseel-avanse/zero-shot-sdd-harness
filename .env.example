AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Model — this build defaults to Gemini's balanced, low-cost tier.
AGENT_LLM_MODEL=gemini-2.5-flash

# Set exactly ONE provider key (this build uses Gemini):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# Data Analyst Agent settings
AGENT_MAX_UPLOAD_MB=10
AGENT_MAX_CODE_ATTEMPTS=3
AGENT_CODE_TIMEOUT_S=15
AGENT_QUERY_LOG_PATH=data/queries.log
AGENT_MAX_DATASETS=16

PORT=8001
