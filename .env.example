# Sentinel — whitebox security assessment agent

# --- Database (real PostgreSQL; NEVER SQLite for gates) ---
# A local Postgres 16 container is expected (Docker `sec-agent-pg`, host port 5433).
AGENT_DATABASE_URL=postgresql+psycopg://secagent:secagent@localhost:5433/secagent

# --- LLM provider — auto-detected from whichever key is set below ---
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Set the Gemini key (provider auto-detects to gemini when this is set):
AGENT_GEMINI_API_KEY=
# AGENT_ANTHROPIC_API_KEY=

# Model tiers (uses provider defaults when blank):
# AGENT_LLM_MODEL_FAST=gemini-3.1-flash    # recon / scanning
# AGENT_LLM_MODEL_SMART=gemini-3.1-pro     # validation / patch generation

# --- Assessment ---
# Bounded agent step budget per run
# AGENT_STEP_BUDGET=40

# --- Optional: LangSmith tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
